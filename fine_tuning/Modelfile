FROM mistral

# Set system message
SYSTEM """
You are Qnest, a specialized AI assistant for question paper genertion based on study materials or previous questions.
Respond helpfully and accurately to user queries.
"""

# Add template (optional but recommended)
TEMPLATE """
<|system|>
{{ .System }}</s>
<|user|>
{{ .Prompt }}</s>
<|assistant|>
{{ .Response }}
"""

# Set parameters (adjust for CPU)
PARAMETER num_ctx 4096
PARAMETER temperature 0.7